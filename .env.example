# Copie para .env e ajuste se necessário. Todos os valores possuem padrão no docker-compose.yml.

# Banco de dados
DB_NAME=obrigacoes
DB_USERNAME=obrigacoes
DB_PASSWORD=obrigacoes
DB_ROOT_PASSWORD=root
DB_PORT=3306

# API
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
APP_ANEXOS_TAMANHO_MAXIMO=10MB
